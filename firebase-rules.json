// ============================================================
// Firebase Realtime Database Security Rules
// โปรเจค: Werewolf Online v2.1
// ออกแบบตาม Data Schema ข้อ 8 ของแผนโปรเจค
// (ข้อ 9 ของแผนอ้างถึงบทสนทนาในแชท — เขียนใหม่ครอบคลุมทุก node)
//
// หลักการเข้าถึง (ยืนยันโดยเจ้าของโปรเจค):
//  ให้ = .read แปลว่า "อ่าน"  .write แปลว่า "เขียน"
//  - players        : อ่านทุกคน / เขียนเจ้าตัว + host
//  - secret/roles   : อ่านเจ้าตัว + host / เขียน host เท่านั้น
//  - secret/cursed  : อ่าน Cursed + host + หมาป่า (หลังคืนถัดไป) / เขียน host
//  - wolf           : อ่าน-เขียนหมาป่า + host (ข้อมูลแกน เช่น victims จำกัด host)
//  - night          : อ่าน host / เขียนเจ้าตัว
//  - hunter, lovers : อ่านทุกคน / เขียน host
//  - spectator      : อ่าน host + ผู้เล่นที่ตาย / เขียน host
// ============================================================
{
  "rules": {
    "rooms": {
      "$code": {
        // อ่านห้อง: ทุกคน (เข้าดูล็อบบี้/สเปคได้)
        ".read": true,

        // เขียนห้อง: สร้างห้องใหม่ได้ทุกคนที่ login /
        //            แก้ไขห้องเดิมได้เฉพาะ host (hostUid หรือ hostUid2)
        ".write": "auth != null && (
                      !data.exists()
                      || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                      || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                   )",

        // ---- meta: ข้อมูลห้อง (phase, day, settings, winner) ----
        "meta": {
          // อ่าน: ทุกคน
          ".read": true,
          // เขียน: host เท่านั้น; แต่สร้างห้องใหม่ได้ (ยังไม่มี meta อยู่)
          ".write": "auth != null && (
                        !root.child('rooms/' + $code + '/meta').exists()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- players: รายชื่อผู้เล่นยืนยันตัวจริง ----
        "players": {
          "$uid": {
            // อ่าน: ทุกคน (ชื่อ/สถานะมีชีวิตเปิดเผยได้)
            ".read": true,
            // เขียน: เจ้าตัว (ตั้งชื่อ/โหวต/avatar) + host
            ".write": "auth != null && (
                          $uid == auth.uid
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          }
        },

        // ---- secret: โซนบทบาทลับ (ห้ามรั่วเด็ดขาด) ----
        "secret": {
          // บล็อกการ list ทั้งโซน secret
          ".read": false,
          ".write": false,

          "roles": {
            "$uid": {
              // อ่าน: เจ้าตัว + host เท่านั้น (DevTools ของคนอื่นไม่มีทางเห็น)
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                        )",
              // เขียน: host เท่านั้น (แจกบทบาทตอนเริ่มเกม)
              ".write": "auth != null && (
                            auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          },

          "cursed": {
            "$uid": {
              // อ่าน: เจ้าตัว (ตัว Cursed เอง) + host +
              //       หมาป่า หลังคืนถัดไปจากคืนที่ถูกกัด (turnedNight + 1)
              //       ใช้ /meta/day เทียบกับ turnedNight เพื่อป้องกันการรู้ก่อนเวลา
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                           || (
                              root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                              && data.child('turnedNight').val() != null
                              && root.child('rooms/' + $code + '/meta/day').val() >= data.child('turnedNight').val() + 1
                           )
                        )",
              // เขียน: host เท่านั้น (คนทรง mark ถูกกัด / กลายเป็นหมาป่า)
              ".write": "auth != null && (
                            auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          }
        },

        // ---- wolf: โซนหมาป่า (members, votes, victims, knowsCursed) ----
        "wolf": {
          "members": {
            // อ่าน: หมาป่า + host เท่านั้น (รู้จักกันในฝ่าย)
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            // เขียน: host เท่านั้น (กำหนดสมาชิกตอนเริ่มเกม)
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "votes": {
            "$wolfUid": {
              // อ่าน: หมาป่า + host (เห็นโหวตของกันและกันแบบเรียลไทม์)
              ".read": "auth != null && (
                           root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                        )",
              // เขียน: หมาป่าโหวตได้แค่ slot ของตัวเอง + host
              ".write": "auth != null && (
                            $wolfUid == auth.uid
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          },
          "victims": {
            // อ่าน: หมาป่า + host เท่านั้น
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            // เขียน: host เท่านั้น (สรุปเหยื่อจากโหวตหมาป่า — ผู้เล่นปลอมไม่ได้)
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "knowsCursed": {
            // อ่าน: หมาป่า + host
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            // เขียน: host เท่านั้น
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          }
        },

        // ---- night: action กลางคืนของแต่ละบทบาท ----
        "night": {
          // อ่าน: host เท่านั้น (คนทรงเห็นทุก action)
          ".read": "auth != null && (
                       auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                       || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                    )",
          "actions": {
            "$uid": {
              // อ่าน: เจ้าตัว + host (เจ้าตัวดู action ของตัวเองได้)
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                        )",
              // เขียน: เจ้าตัวเท่านั้น (ใครก็ไปเขียนให้คนอื่นไม่ได้)
              ".write": "auth != null && $uid == auth.uid"
            }
          }
        },

        // ---- hunter: การยิงของนายพราน ----
        "hunter": {
          // อ่าน: ทุกคน เมื่อถูกเปิดเผยแล้ว (revealed = true)
          ".read": true,
          // เขียน: host เท่านั้น (คนทรงควบคุม reveal + ยิง)
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- lovers: คู่รัก (เปิดเผยเมื่อจบเกม / สเปคตากระต่าย) ----
        "lovers": {
          ".read": true,
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- spectator: มุมมองของผู้ชม ----
        "spectator": {
          // อ่าน: host + ผู้เล่นที่ตายแล้ว (alive = false) เท่านั้น
          ".read": "auth != null && (
                       auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                       || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       || root.child('rooms/' + $code + '/players/' + auth.uid + '/alive').val() == false
                    )",
          // เขียน: host เท่านั้น
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        }
      }
    }
  }
}