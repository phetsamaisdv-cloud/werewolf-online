// ============================================================
// Firebase Realtime Database Security Rules v2
// โปรเจค: Werewolf Online v2.1
// ออกแบบตาม Data Schema ข้อ 8 ของแผนโปรเจค + บันทึกการค้นพบ:
//
// ⚠️ RTDB ใช้หลัก "grant ถ้ามี rule ใดระดับหนึ่งยอม" (shallower grants
//    cascade ลงมาทุก descendant และ rule ลึกกว่ารีบวอกไม่ได้)
//    -> ห้ามตี ".read" เปิดที่ node ครอบ (rooms/$code) เพราะจะรั่วทุกอย่าง
//    -> จากเดิม $code.read:true ทำให้ secret/wolf/night เปิดอ่านได้หมด — แก้แล้ว
//
// หลักการเข้าถึง (ยืนยันโดยเจ้าของโปรเจค §9):
//  - meta, players, hunter, lovers  : อ่านทุกคน
//  - secret/roles                   : อ่านเจ้าตัว + host (+ทุกคนเมื่อเฟส end)
//  - secret/cursed                  : อ่านตัว Cursed + host + หมาป่า (หลังคืนถัดไป)
//  - wolf/*                         : อ่าน หมาป่า + host
//  - night/actions                  : อ่านเจ้าตัว + host
//  - spectator                      : อ่าน host + ผู้เล่นที่ตายแล้ว
//  - เขียน: host ควบคุม meta/roles/cursed/wolf/*/night(อ่าน)/hunter/lovers/spectator
//    ผู้เล่นเขียนได้เฉพาะ players/$uid (ตัวเอง) + night/actions/$uid (ตัวเอง)
// ============================================================
{
  "rules": {
    "rooms": {
      "$code": {
        // ---- เขียนระดับห้อง: สร้างห้องใหม่ (ทุกคนที่ login) / host แก้ไข-ลบห้อง ----
        // (ห้ามใส่ ".read" ระดับนี้เด็ดขาด — จะทำให้ secret/wolf รั่วหมด)
        ".write": "auth != null && (
                      !data.exists()
                      || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                      || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                   )",

        // ---- meta: ข้อมูลห้อง (phase, day, settings, winner) ----
        "meta": {
          ".read": true,
          ".write": "auth != null && (
                        !root.child('rooms/' + $code + '/meta').exists()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- players: รายชื่อผู้เล่น (ชื่อ/มีชีวิต/โหวต — เปิดเผยได้) ----
        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && (
                          $uid == auth.uid
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          }
        },

        // ---- secret: โซนบทบาทลับ (ไม่มี ".read" ที่ตัวนี้/ที่ rooms — ค่า default deny) ----
        "secret": {
          ".write": false,
          "roles": {
            "$uid": {
              // อ่าน: เจ้าตัว + host + ทุกคนเมื่อเกมจบ (เฟส end — เฉลยบทบาท)
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                           || root.child('rooms/' + $code + '/meta/phase').val() == 'end'
                        )",
              ".write": "auth != null && (
                            auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          },
          "cursed": {
            "$uid": {
              // อ่าน: เจ้าตัว + host + หมาป่า แต่ต้องถึงคืนถัดไปจากคืนที่ถูกกัด
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                           || (
                              root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                              && data.child('turnedNight').val() != null
                              && root.child('rooms/' + $code + '/meta/day').val() >= data.child('turnedNight').val() + 1
                           )
                        )",
              ".write": "auth != null && (
                            auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          }
        },

        // ---- wolf: โซนหมาป่า (read: หมาป่า + host เท่านั้น) ----
        "wolf": {
          "members": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "votes": {
            "$wolfUid": {
              ".read": "auth != null && (
                           root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                        )",
              ".write": "auth != null && (
                            $wolfUid == auth.uid
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                            || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                         )"
            }
          },
          "victims": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "knowsCursed": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "lastBodyguardTarget": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "doubleKill": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          },
          "sickNext": {
            ".read": "auth != null && (
                         root.child('rooms/' + $code + '/secret/roles/' + auth.uid + '/team').val() == 'wolf'
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                         || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                      )",
            ".write": "auth != null && (
                          auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                          || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       )"
          }
        },

        // ---- night: action กลางคืนของแต่ละบทบาท ----
        "night": {
          ".read": "auth != null && (
                       auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                       || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                    )",
          "actions": {
            "$uid": {
              ".read": "auth != null && (
                           $uid == auth.uid
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                           || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                        )",
              ".write": "auth != null && $uid == auth.uid"
            }
          }
        },

        // ---- hunter: การยิงของนายพราน (เปิดเผยแบบสาธารณะ) ----
        "hunter": {
          ".read": true,
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- lovers: คู่รัก (เปิดเผยเมื่อจบเกม) ----
        "lovers": {
          ".read": true,
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        },

        // ---- spectator: มุมมองผู้ชม (host + ผู้เล่นที่ตาย) ----
        "spectator": {
          ".read": "auth != null && (
                       auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                       || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                       || root.child('rooms/' + $code + '/players/' + auth.uid + '/alive').val() == false
                    )",
          ".write": "auth != null && (
                        auth.uid == root.child('rooms/' + $code + '/meta/hostUid').val()
                        || auth.uid == root.child('rooms/' + $code + '/meta/hostUid2').val()
                     )"
        }
      }
    }
  }
}